# VoiceKit API Key (required)
# Get yours at https://kond.studio/developers/voicekit
NEXT_PUBLIC_VOICEKIT_API_KEY=vk_your_key_here

# LLM Provider: claude | openai | ollama | echo
NEXT_PUBLIC_LLM_PROVIDER=claude

# LLM Model (optional - defaults based on provider)
# Claude: claude-3-haiku-20240307, claude-3-5-sonnet-20241022, etc.
# OpenAI: gpt-4o-mini, gpt-4o, etc.
# Ollama: llama3, mistral, etc.
NEXT_PUBLIC_LLM_MODEL=

# Claude (required if LLM_PROVIDER=claude)
NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI (required if LLM_PROVIDER=openai)
NEXT_PUBLIC_OPENAI_API_KEY=sk-your_key_here

# Ollama (if LLM_PROVIDER=ollama)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
