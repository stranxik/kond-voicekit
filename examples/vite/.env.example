# VoiceKit API Key (required)
# Get yours at https://kond.studio/developers/voicekit
VITE_VOICEKIT_API_KEY=vk_your_key_here

# LLM Provider: claude | openai | ollama | echo
VITE_LLM_PROVIDER=claude

# LLM Model (optional - defaults based on provider)
# Claude: claude-3-haiku-20240307, claude-3-5-sonnet-20241022, etc.
# OpenAI: gpt-4o-mini, gpt-4o, etc.
# Ollama: llama3, mistral, etc.
VITE_LLM_MODEL=

# Claude (required if LLM_PROVIDER=claude)
VITE_ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI (required if LLM_PROVIDER=openai)
VITE_OPENAI_API_KEY=sk-your_key_here

# Ollama (if LLM_PROVIDER=ollama)
VITE_OLLAMA_URL=http://localhost:11434

# ElevenLabs Voice ID (optional - uses backend default if not set)
# Find voice IDs at https://elevenlabs.io/app/voice-library
# Default EN: 21m00Tcm4TlvDq8ikWAM (Rachel)
# Default FR: pNInz6obpgDQGcFmaJgB (Adam)
VITE_ELEVENLABS_VOICE_ID=

# Locale for STT/TTS: fr | en | multi
# - "fr" or "en": Single language mode
# - "multi": Auto-detect (FR/EN/ES/DE/IT/PT/JA/NL/RU/HI)
# Voice auto-selects: "en" -> Rachel, "fr" -> Adam
VITE_LOCALE=en

# Turn Detection Mode: auto | local | cloud | heuristic
# - "auto" (default): Desktop -> local ONNX, Mobile -> cloud
# - "local": Force browser ONNX inference (~25-50ms)
# - "cloud": Force Railway API (~100-200ms)
# - "heuristic": Fast regex fallback (~1-5ms, offline)
VITE_TURN_DETECTOR=auto
